# --- Connection -------------------------------------------------------------
# Comma-separated broker list (host:port).
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=mcp-kafka
# Enable TLS.
KAFKA_SSL=false
# SASL auth (optional). Mechanism: plain | scram-sha-256 | scram-sha-512.
# KAFKA_SASL_MECHANISM=scram-sha-512
# KAFKA_SASL_USERNAME=
# KAFKA_SASL_PASSWORD=
KAFKA_CONNECTION_TIMEOUT_MS=10000

# --- Security flags ---------------------------------------------------------
# Access mode: read-only | read-write | admin. Start with read-only.
KAFKA_MODE=read-only
# Comma-separated topic allowlist. Empty = all topics.
KAFKA_TOPIC_ALLOWLIST=
# Topics that can be read but never mutated/deleted.
KAFKA_PROTECTED_TOPICS=
# Treat internal topics (starting with _) as protected. Recommended: true.
KAFKA_PROTECT_INTERNAL_TOPICS=true
# delete_topic / delete_consumer_group require this in addition to admin mode.
KAFKA_ALLOW_DELETE=false
# Validate + log writes without sending them to the cluster.
KAFKA_DRY_RUN=false
# Emit a JSON audit line to stderr per guarded operation.
KAFKA_AUDIT_LOG=true
