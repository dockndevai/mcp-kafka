{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.dockndevai/mcp-kafka",
  "description": "Apache Kafka monitoring & management for AI agents (with consumer lag) — governed.",
  "version": "0.1.3",
  "repository": {
    "url": "https://github.com/dockndevai/mcp-kafka",
    "source": "github"
  },
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "@dockndevai/mcp-kafka",
      "version": "0.1.3",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "KAFKA_BROKERS",
          "description": "Comma-separated broker list (host:port).",
          "isRequired": true,
          "isSecret": false
        },
        {
          "name": "KAFKA_MODE",
          "description": "Access mode: read-only | read-write | admin.",
          "isRequired": false,
          "isSecret": false
        }
      ]
    }
  ]
}
